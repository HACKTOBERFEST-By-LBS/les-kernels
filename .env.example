# Copie ce fichier en .env. Le fichier .env ne doit JAMAIS être committé.
GEMINI_API_KEY=
# Facultatif : autre modèle Gemma servi par l'API Gemini.
GEMMA_MODEL=gemma-4-26b-a4b-it

OPENWA_API_URL=http://127.0.0.1:8080
# Change ces deux valeurs : avec les valeurs par défaut, n'importe qui sur le réseau peut faire écrire le bot.
WA_API_KEY=hackathon-dev-key
OPEN_WA_WEBHOOK_SECRET=hackathon-local-secret
